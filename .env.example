# Copy to .env and fill in from your Supabase project:
#   Project Settings -> API -> Project URL / Project API keys (anon public)
# The anon key is safe to ship in a client bundle; RLS is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# If these are absent the game runs in offline mode: no login screen, no
# leaderboard, nothing persists — same as stage 1.
